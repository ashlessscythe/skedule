DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
SHADOW_DATABASE_URL="postgresql://user:password@host/dbname_shadow?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-strong-random-string"

DEFAULT_TENANT_SLUG="acme-health"

RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM_DEFAULT="Scheduling App <no-reply@example.com>"
SEND_EMAIL="false"

# Optional: registration approval notifications
# Comma-separated fallback emails to notify when a new registration is pending.
# If not set, notifications go to ACTIVE tenant admins (role=ADMIN) only.
REGISTRATION_ADMIN_NOTIFY_EMAILS=""

# Optional: scheduled reminder emails (GET/POST /api/cron/appointment-reminders)
CRON_SECRET="long-random-string-for-cron-only"
# Hours before start time to send reminder (default 24). Cron should run at least as often as the slack window (30m).
REMINDER_HOURS_BEFORE="24"

TURNSTILE_SITE_KEY="0x0000000000000000000000000000000000000000"
TURNSTILE_SECRET_KEY="0x0000000000000000000000000000000000000000"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""